{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import"],
  "ignorePatterns": ["dist", "coverage", "playwright-report", "test-results"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["react", "react/*", "react-dom", "react-dom/*", "**/app/**", "**/ui/**"],
                "message": "Доменный слой — чистый TypeScript: без React и без импортов из app/ui."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          { "name": "window", "message": "Домен не знает о браузере." },
          { "name": "document", "message": "Домен не знает о браузере." },
          { "name": "localStorage", "message": "Сохранение — через адаптер вне домена." }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "Math",
            "property": "random",
            "message": "Случайность — только через Rng из домена."
          }
        ]
      }
    }
  ]
}
